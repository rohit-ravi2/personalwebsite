---
import { PROFILE } from "../../content/profileData";
import { getCollection } from "astro:content";

type Study = { category: string; title: string; institution?: string };

const education = (PROFILE.studies as Study[]).filter((study) => study.category === "Education");

// Certificates that match the research and the philosophy minor lead.
// Anything else follows by issue date.
const LEAD = ["computational-neuroscience", "mind-and-machine", "question-reality"];

const certs = (await getCollection("certifications")).sort((a, b) => {
  const rank = (slug: string) => {
    const index = LEAD.indexOf(slug);
    return index === -1 ? LEAD.length : index;
  };
  const byRank = rank(a.slug) - rank(b.slug);
  if (byRank !== 0) return byRank;
  return b.data.issueDate.valueOf() - a.data.issueDate.valueOf();
});

const rows = await Promise.all(certs.map(async (cert) => {
  const bundled = !cert.data.verifyUrl && !cert.data.pdfPath && cert.body?.trim();
  return { cert, Content: bundled ? (await cert.render()).Content : null };
}));

const year = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", timeZone: "UTC" });

function school(issuer: string) {
  return issuer.replace(/^Coursera\s·\s/, "");
}
---

<div class="mt-1 flex flex-col gap-3 text-sm">
  {education.map((study) => (
    <div>
      <p class="font-medium leading-snug">{study.title}</p>
      {study.institution && <p class="text-muted-foreground">{study.institution}</p>}
    </div>
  ))}

  <ul class="flex flex-col gap-2 border-t border-border pt-3">
    {rows.map(({ cert, Content }) => {
      const href = cert.data.verifyUrl ?? cert.data.pdfPath;
      const detail = [
        school(cert.data.issuer),
        year(cert.data.issueDate),
        cert.data.courseCount ? `${cert.data.courseCount} courses` : "",
      ].filter(Boolean).join(", ");
      return (
        <li class="leading-snug">
          {href ? (
            <a href={href} target="_blank" rel="noreferrer" class="font-medium hover:underline">
              {cert.data.title}
            </a>
          ) : (
            <span class="font-medium">{cert.data.title}</span>
          )}
          <span class="block text-xs text-muted-foreground">{detail}</span>
          {Content && (
            <details class="mt-1">
              <summary class="cursor-pointer text-xs text-primary hover:underline">Course certificates</summary>
              <div class="prose prose-sm mt-2 max-w-none overflow-x-auto">
                <Content />
              </div>
            </details>
          )}
        </li>
      );
    })}
  </ul>
</div>
