---
import { getCollection } from "astro:content";
import InProgressBadge from "../InProgressBadge.astro";
const entries = await getCollection("projects");
const selected = ["handwriting-emg", "libribrain-2026", "asd-myelin-timing"];
const projects = selected
  .map((slug) => entries.find((entry) => entry.slug === slug))
  .filter(Boolean);
---

<div class="mt-2 space-y-5">
  {
    projects.map(
      (project) =>
        project && (
          <article class="border-b pb-5 last:border-b-0 last:pb-0">
            <div class="mb-1 flex flex-wrap items-center gap-2">
              <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                {project.data.subject}
              </span>
              {project.data.inProgress && <InProgressBadge />}
            </div>
            <h3 class="text-lg font-semibold text-primary">
              <a href={`/projects/${project.slug}`} class="hover:underline">
                {project.data.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed">
              {project.data.description}
            </p>
          </article>
        ),
    )
  }
  <a
    href="/projects"
    class="inline-block text-sm font-semibold text-primary underline underline-offset-4"
    >All projects <span aria-hidden="true">→</span></a
  >
</div>
