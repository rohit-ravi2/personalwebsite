---
import { PROFILE } from "../../content/profileData";
import { Github, Linkedin, Mail } from "lucide-react";
const socials = [
  { href: PROFILE.links.github, label: "GitHub", Icon: Github },
  { href: PROFILE.links.linkedin, label: "LinkedIn", Icon: Linkedin },
  { href: PROFILE.links.email, label: "Email", Icon: Mail },
];
---

<div class="flex h-full flex-col justify-between gap-7">
  <div>
    <p class="text-sm font-medium text-muted-foreground">
      {PROFILE.shortIntros[0]}
    </p>
    {
      PROFILE.shortIntros.length > 1 && (
        <ul class="mt-1 space-y-1 text-sm text-muted-foreground">
          {PROFILE.shortIntros.slice(1).map((intro) => (
            <li>{intro}</li>
          ))}
        </ul>
      )
    }
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
      {PROFILE.name}
    </h1>
    <p class="mt-4 max-w-xl text-xl font-medium leading-snug sm:text-2xl">
      {PROFILE.headLine}
    </p>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
      {PROFILE.headLine2}
    </p>
  </div>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <a
      href="/projects"
      class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:opacity-90"
      >Explore my work</a
    >
    {
      socials.map(({ href, label, Icon }) => (
        <a
          href={href}
          class="inline-flex items-center gap-2 text-sm font-medium hover:underline"
          target={label === "Email" ? undefined : "_blank"}
          rel={label === "Email" ? undefined : "noreferrer"}
        >
          <Icon size={16} aria-hidden="true" />
          {label}
        </a>
      ))
    }
  </div>
</div>
