---
import { getCollection } from "astro:content";
import { formateLocalMonth } from "../../lib/utils";
const experiences = (await getCollection("experiences"))
  .filter((exp) => !exp.data.title.startsWith("Competitor"))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
---

<div class="mt-2 space-y-5 text-sm leading-relaxed">
  {
    experiences.map((exp) => (
      <div>
        <h3 class="text-base font-semibold">{exp.data.title}</h3>
        <p class="mt-1">{exp.data.company}</p>
        <p class="mt-1 text-xs text-muted-foreground">
          {formateLocalMonth(exp.data.startDate)} –{" "}
          {exp.data.endDate ? formateLocalMonth(exp.data.endDate) : "Present"}
        </p>
      </div>
    ))
  }
  <p class="text-muted-foreground">
    My work spans neural decoding, computational models of nervous systems, and
    the analysis of biological data.
  </p>
  <div class="border-t pt-4">
    <p class="font-medium">Technical focus</p>
    <p class="mt-2 text-muted-foreground">
      Python · PyTorch · neural time series · model adaptation · statistical
      genetics · evaluation
    </p>
  </div>
  <a
    href="/experiences"
    class="inline-block font-semibold text-primary underline underline-offset-4"
    >Research experience <span aria-hidden="true">→</span></a
  >
</div>
