---
import IndexPageLayout from "../../layouts/IndexPageLayout.astro";
import { tools } from "../../data/tools";
---

<IndexPageLayout
  wide
  title="Tools & demos — Rohit Ravi"
  subTitle="Tools & demos"
  description="Explore the models, data, and simulations behind the projects."
>
  <div class="w-full">
    <p class="mb-6 max-w-prose text-sm leading-relaxed text-muted-foreground">
      Each tool states what runs in your browser and what comes from saved
      results. The linked project pages explain the methods and limits.
    </p>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <article class="flex flex-col rounded-xl border bg-card p-6">
            <>
              <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                {tool.kind}
              </p>
              <h2 class="mt-3 text-xl font-semibold">
                <a
                  href={`/tools/${tool.slug}`}
                  class="text-primary hover:underline"
                >
                  {tool.title}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed">
                {tool.description}
              </p>
              <div class="mt-5 flex flex-wrap gap-5 text-sm font-semibold text-primary">
                <>
                  <a
                    class="underline underline-offset-4"
                    href={`/tools/${tool.slug}`}
                  >
                    Open tool →
                  </a>
                  <a
                    class="underline underline-offset-4"
                    href={`/projects/${tool.project}`}
                  >
                    Methods & results
                  </a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div>
</IndexPageLayout>
