---
import BaseLayout from "../layouts/BaseLayout.astro";
import CustomisedBreadCrumbs from "../components/CustomisedBreadCrumbs.astro";
import { getEntry } from "astro:content";
import about from "../data/about.json";
// The "Explore the work" box sits just before the "What I want to contribute" section.
const exploreAfter =
  about.sections.findIndex((section) => section.title === "What I want to contribute") - 1;
const selectedWork = await Promise.all(
  [
    "handwriting-emg",
    "libribrain-2026",
    "microns-dendritic",
    "neural-control",
  ].map(async (slug) => {
    const project = await getEntry("projects", slug);
    return {
      slug,
      title: project?.data.title,
      description: project?.data.description,
    };
  }),
);
---

<BaseLayout
  title="About — Rohit Ravi"
  description="How illness, philosophy, and a search for understanding led Rohit Ravi to work in machine learning, neuroscience, and computation."
>
  <main class="mx-auto w-full max-w-4xl px-5 py-10 sm:px-8">
    <CustomisedBreadCrumbs />
    <header
      class="mt-8 grid items-center gap-8 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-12"
    >
      <figure class="mx-auto w-full max-w-xs md:mx-0 md:max-w-none">
        <img
          src="/images/about/rohit-ravi.jpg"
          alt="Rohit Ravi in a navy suit, standing between stone columns."
          width="1024"
          height="1536"
          class="aspect-[3/4] w-full rounded-lg object-cover object-[center_18%]"
          fetchpriority="high"
        />
      </figure>
      <div>
        <p
          class="text-xs font-medium uppercase tracking-[0.16em] text-muted-foreground"
        >
          About me
        </p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">
          Rohit Ravi
        </h1>
        <p class="mt-5 text-xl leading-relaxed">{about.lead}</p>
        <p class="mt-5 leading-relaxed text-muted-foreground">
          {about.introduction}
        </p>
      </div>
    </header>

    <div
      class="mx-auto mt-16 flex max-w-[65ch] flex-col gap-12 text-base leading-[1.85]"
    >
      {
        about.sections.map((section, index) => (
          <>
            <section aria-labelledby={`about-section-${index}`}>
              <h2
                id={`about-section-${index}`}
                class="border-t pt-8 text-2xl font-semibold tracking-tight"
              >
                {section.title}
              </h2>
              <div class="mt-5 flex flex-col gap-5">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </section>
            {index === exploreAfter && (
              <aside
                class="rounded-xl border bg-card p-5 sm:p-6"
                aria-label="Selected research"
              >
                <p class="mb-4 text-xs font-medium uppercase tracking-[0.16em] text-muted-foreground">
                  Explore the work
                </p>
                <div class="grid gap-5 sm:grid-cols-2">
                  {selectedWork.map((project) => (
                    <a
                      href={`/projects/${project.slug}`}
                      class="group block rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
                    >
                      <span class="block text-base font-semibold leading-snug text-primary group-hover:underline">
                        {project.title}
                      </span>
                      <span class="mt-2 block text-sm leading-relaxed text-muted-foreground">
                        {project.description}
                      </span>
                    </a>
                  ))}
                </div>
              </aside>
            )}
          </>
        ))
      }
      <a
        href="mailto:rohit.ravi2@gmail.com"
        class="w-fit rounded-md bg-primary px-5 py-3 text-sm font-medium text-primary-foreground hover:opacity-90"
        >Get in touch</a
      >
    </div>
  </main>
</BaseLayout>
