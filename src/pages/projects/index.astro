---
import ProjectCard from "src/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import IndexPageLayout from "../../layouts/IndexPageLayout.astro";
import { SELECTED_WORK } from "../../data/selectedWork";

const SUBJECT_ORDER = [
  "Neural decoding",
  "C. elegans",
  "Cortical connectomics",
  "Human genetics",
  "Clinical and molecular",
  "Robotics",
  "Competitions",
  "Vision",
  "Reasoning",
];

const allProjects = await getCollection("projects");
allProjects.sort((a: any, b: any) => {
  return (
    new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime()
  );
});

const projects = allProjects.filter((project) => !project.data.earlierWork);
const earlier = allProjects.filter((project) => project.data.earlierWork);
const selected = SELECTED_WORK.map((slug) =>
  allProjects.find((project) => project.slug === slug),
).filter(Boolean);
const year = (date: Date) => new Date(date).getUTCFullYear();

const grouped = SUBJECT_ORDER.map((subject) => ({
  subject,
  items: projects.filter((project) => project.data.subject === subject),
})).filter((group) => group.items.length > 0);

const ungrouped = projects.filter(
  (project) => !SUBJECT_ORDER.includes(project.data.subject),
);
---

<IndexPageLayout
  wide
  title="Projects"
  description="Research and engineering across neural decoding, computational biology, and machine learning."
  subTitle="Projects"
>
  {
    projects.length === 0 ? (
      <p class="text-sm text-muted-foreground italic">
        More projects coming soon.
      </p>
    ) : (
      <div class="flex w-full flex-col gap-10">
        {selected.length > 0 && (
          <section class="w-full" aria-labelledby="selected-work">
            <h2 id="selected-work" class="mb-3 text-xl font-semibold">
              Selected work
            </h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {selected.map((entity: any) => (
                <ProjectCard
                  href={"/projects/" + entity.slug}
                  heading={entity.data.title}
                  subheading={entity.data.description}
                  altText={entity?.data?.image?.alt}
                  imagePath={entity?.data?.image?.url}
                  dateStart={entity.data.startDate}
                  inProgress={entity.data.inProgress}
                />
              ))}
            </div>
          </section>
        )}
        <nav aria-label="Project subjects" class="flex flex-wrap gap-2">
          {grouped.map((group) => (
            <a
              href={`#${group.subject.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
              class="rounded-full border px-3 py-1.5 text-sm hover:border-primary hover:bg-white/50"
            >
              {group.subject}
            </a>
          ))}
        </nav>
        {grouped.map((group) => (
          <section
            class="w-full"
            aria-labelledby={group.subject
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")}
          >
            <h2
              id={group.subject.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
              class="mb-3 text-xl font-semibold"
            >
              {group.subject}
            </h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {group.items.map((entity: any) => (
                <ProjectCard
                  class={group.items.length === 1 ? "sm:col-span-2" : ""}
                  wide={group.items.length === 1}
                  href={"/projects/" + entity.slug}
                  heading={entity.data.title}
                  subheading={entity.data.description}
                  altText={entity?.data?.image?.alt}
                  imagePath={entity?.data?.image?.url}
                  dateStart={entity.data.startDate}
                  inProgress={entity.data.inProgress}
                />
              ))}
            </div>
          </section>
        ))}
        {ungrouped.length > 0 && (
          <section class="w-full" aria-labelledby="subject-other">
            <h2 id="subject-other" class="mb-3 text-xl font-semibold">
              Other
            </h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {ungrouped.map((entity: any) => (
                <ProjectCard
                  class={ungrouped.length === 1 ? "sm:col-span-2" : ""}
                  wide={ungrouped.length === 1}
                  href={"/projects/" + entity.slug}
                  heading={entity.data.title}
                  subheading={entity.data.description}
                  altText={entity?.data?.image?.alt}
                  imagePath={entity?.data?.image?.url}
                  dateStart={entity.data.startDate}
                  inProgress={entity.data.inProgress}
                />
              ))}
            </div>
          </section>
        )}
        {earlier.length > 0 && (
          <section class="w-full" aria-labelledby="earlier-work">
            <h2 id="earlier-work" class="mb-3 text-xl font-semibold">
              Earlier work
            </h2>
            <ul class="divide-y rounded-xl border bg-card text-sm">
              {earlier.map((entity: any) => (
                <li class="flex flex-col gap-1 px-5 py-3 sm:flex-row sm:items-baseline sm:gap-4">
                  <span class="shrink-0 text-xs text-muted-foreground">
                    {year(entity.data.startDate)}
                  </span>
                  <a
                    href={"/projects/" + entity.slug}
                    class="shrink-0 font-semibold hover:text-primary hover:underline"
                  >
                    {entity.data.title}
                  </a>
                  <span class="text-muted-foreground">
                    {entity.data.description}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )
  }
</IndexPageLayout>
