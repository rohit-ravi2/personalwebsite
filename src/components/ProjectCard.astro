---
import InProgressBadge from "./InProgressBadge.astro";

const {
  as: Tag = "a",
  class: className = "",
  href,
  heading,
  subheading,
  imagePath,
  altText,
  dateStart,
  inProgress = false,
} = Astro.props;
const date = dateStart ? new Date(dateStart) : null;
const dateLabel =
  date && !Number.isNaN(date.getTime())
    ? new Intl.DateTimeFormat("en-US", {
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      }).format(date)
    : null;
---

<Tag
  href={href}
  class={`group flex h-full flex-col overflow-hidden rounded-xl border bg-card p-0 shadow-sm transition-colors hover:border-primary ${className}`}
>
  {
    imagePath && (
      <img
        src={imagePath}
        alt={altText ?? ""}
        class="h-44 w-full border-b object-cover"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      {
        dateLabel && (
          <time
            datetime={date!.toISOString().slice(0, 10)}
            class="text-xs text-muted-foreground"
          >
            {dateLabel}
          </time>
        )
      }
      {inProgress && <InProgressBadge />}
    </div>
    <h3 class="text-lg font-semibold leading-snug group-hover:text-primary">
      {heading}
    </h3>
    <p class="text-sm leading-relaxed text-muted-foreground">{subheading}</p>
  </div>
</Tag>
