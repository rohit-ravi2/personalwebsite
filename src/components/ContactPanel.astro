---
import { ArrowUpRight } from "lucide-react";
const topics = [
  { value: "collaboration", label: "Collaboration" },
  { value: "research", label: "Research opportunity" },
  { value: "other", label: "Something else" },
];
---

<div id="contact" class="contact-panel mt-3">
  <form data-contact-form novalidate>
    <p class="mb-5 text-sm leading-relaxed text-muted-foreground">
      Tell me what you’re working on or what you’d like to discuss.
    </p>
    <fieldset data-contact-fields class="min-w-0 space-y-5">
      <fieldset>
        <legend class="mb-2 text-sm font-medium"
          >What brings you here? <span class="font-normal text-muted-foreground"
            >Optional</span
          ></legend
        >
        <div class="flex flex-wrap gap-2">
          {
            topics.map((topic) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="topic"
                  value={topic.value}
                  class="peer sr-only"
                />
                <span class="inline-flex min-h-10 items-center rounded-full border px-3 py-2 text-xs font-medium transition-colors peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary">
                  {topic.label}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="contact-email" class="block text-sm font-medium"
            >Your email <span class="sr-only">(required)</span></label
          >
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength="254"
            class="mt-2 min-h-11 w-full rounded-lg border bg-white/70 px-3 py-2 text-sm"
            aria-describedby="contact-email-help"
          />
          <p id="contact-email-help" class="mt-1 text-xs text-muted-foreground">
            Where I can reply.
          </p>
        </div>
        <div>
          <label for="contact-name" class="block text-sm font-medium"
            >Your name <span class="font-normal text-muted-foreground"
              >Optional</span
            ></label
          >
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            maxlength="100"
            class="mt-2 min-h-11 w-full rounded-lg border bg-white/70 px-3 py-2 text-sm"
          />
        </div>
      </div>
      <div>
        <label for="contact-message" class="block text-sm font-medium"
          >Message <span class="sr-only">(required)</span></label
        >
        <p
          data-contact-prompt
          id="contact-message-help"
          class="mt-1 text-xs leading-relaxed text-muted-foreground"
        >
          An idea, a question, or a brief introduction is a good place to start.
        </p>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          minlength="10"
          maxlength="5000"
          aria-describedby="contact-message-help contact-count"
          class="mt-2 w-full resize-y rounded-lg border bg-white/70 px-3 py-2 text-sm leading-relaxed"
        ></textarea>
        <div
          class="mt-1 flex flex-wrap justify-between gap-x-4 gap-y-1 text-xs text-muted-foreground"
        >
          <p data-contact-draft aria-live="polite"></p>
          <p id="contact-count" data-contact-count>0 / 5,000</p>
        </div>
      </div>
      <div class="contact-honeypot" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input
          id="contact-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <div
        data-contact-error
        hidden
        role="alert"
        class="rounded-lg border border-red-800/30 bg-red-50 p-3 text-sm leading-relaxed text-red-950"
      >
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button
          data-contact-send
          type="submit"
          disabled
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 disabled:cursor-wait disabled:opacity-60"
        >
          <span data-contact-send-label>Send message</span><span
            aria-hidden="true"
            data-contact-arrow><ArrowUpRight size={16} /></span
          >
        </button>
        <button
          data-contact-clear
          type="button"
          hidden
          class="min-h-10 rounded px-2 text-xs text-muted-foreground underline underline-offset-4"
          >Clear draft</button
        >
      </div>
    </fieldset>
  </form>

  <section
    data-contact-receipt
    hidden
    class="rounded-xl border border-primary/20 bg-white/40 p-5"
    aria-label="Message confirmation"
  >
    <svg
      class="mb-4 h-8 w-8 text-primary"
      viewBox="0 0 32 32"
      fill="none"
      aria-hidden="true"
      ><circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="1.5"
      ></circle><path
        d="m9 16 5 5 9-10"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
    <h3
      data-contact-thanks
      tabindex="-1"
      class="w-fit rounded text-xl font-semibold"
    >
      Thanks for reaching out.
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      Your message has been submitted.
    </p>
    <dl class="mt-5 space-y-3 border-t pt-4 text-sm">
      <div>
        <dt class="text-xs text-muted-foreground">Reply address</dt><dd
          data-contact-reply
          class="mt-1 break-words font-medium"
        >
        </dd>
      </div>
      <div>
        <dt class="text-xs text-muted-foreground">Conversation</dt><dd
          data-contact-topic
          class="mt-1"
        >
        </dd>
      </div>
      <div>
        <dt class="text-xs text-muted-foreground">Reference</dt><dd
          data-contact-reference
          class="mt-1 font-mono text-xs"
        >
        </dd>
      </div>
    </dl>
    <button
      data-contact-again
      type="button"
      class="mt-5 min-h-10 rounded text-sm font-medium text-primary underline underline-offset-4"
      >Send another message</button
    >
  </section>
  <noscript
    ><p class="mt-4 text-sm">
      Please use the email link below to get in touch.
    </p></noscript
  >
  <p class="mt-5 break-words text-xs leading-relaxed text-muted-foreground">
    Prefer email? <a
      href="mailto:rohit.ravi2@gmail.com"
      class="rounded font-medium text-primary underline underline-offset-4"
      >rohit.ravi2@gmail.com</a
    >
  </p>
</div>

<script src="../scripts/contact.js"></script>
<style>
  .contact-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-panel [hidden] {
    display: none !important;
  }
</style>
