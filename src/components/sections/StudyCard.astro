---
import { PROFILE } from "../../content/profileData";
import Certifications from "../Certifications.astro";
const education = PROFILE.studies.filter(
  (study) => study.category === "Education",
);
---

<div class="mt-1 flex flex-col gap-4 text-sm">
  {
    education.map((study) => (
      <div>
        <>
          <p class="font-medium leading-snug">{study.title}</p>
          <p class="text-muted-foreground">{study.institution}</p>
        </>
      </div>
    ))
  }
  <p
    class="border-t pt-3 text-xs font-medium uppercase tracking-wide text-muted-foreground"
  >
    Selected certifications
  </p>
  <Certifications compact />
  <a
    href="/experiences#certifications"
    class="w-fit font-medium text-primary underline underline-offset-4"
    >All certifications <span aria-hidden="true">→</span></a
  >
</div>
