---
import { getCollection } from "astro:content";
import { formateLocalMonth } from "../../lib/utils";
import IndexPageLayout from "../../layouts/IndexPageLayout.astro";
import { PROFILE } from "../../content/profileData";
import TechnicalSkills from "../../components/TechnicalSkills.astro";
import Certifications from "../../components/Certifications.astro";
const experiences = (await getCollection("experiences"))
  .filter((entry) => !entry.data.title.startsWith("Competitor"))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
---

<IndexPageLayout
  title="Research experience — Rohit Ravi"
  description="Research experience, technical skills, and certifications across machine learning, neuroscience, and scientific software."
  subTitle="Research experience"
>
  <div class="w-full max-w-4xl space-y-10 py-4">
    <nav
      aria-label="Experience sections"
      class="flex flex-wrap gap-3 text-sm font-medium text-primary"
    >
      <a
        href="#technical-skills"
        class="rounded-full border px-4 py-2 hover:border-primary"
        >Technical skills</a
      >
      <a
        href="#certifications"
        class="rounded-full border px-4 py-2 hover:border-primary"
        >Certifications</a
      >
    </nav>
    {
      experiences.map((entry) => (
        <section class="rounded-lg border bg-card p-6">
          <p class="text-sm text-muted-foreground">
            {formateLocalMonth(entry.data.startDate)} –{" "}
            {entry.data.endDate
              ? formateLocalMonth(entry.data.endDate)
              : "Present"}
          </p>
          <h2 class="mt-2 text-2xl font-semibold">
            <a href={`/experiences/${entry.slug}`} class="hover:underline">
              {entry.data.title}
            </a>
          </h2>
          <p class="mt-2 leading-relaxed">{entry.data.company}</p>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            My research interests span computational neuroscience and machine
            learning, including models of nervous systems and the interpretation
            of neural and biological data.
          </p>
          <a
            href={`/experiences/${entry.slug}`}
            class="mt-4 inline-block text-sm font-semibold text-primary underline underline-offset-4"
          >
            Read more
          </a>
        </section>
      ))
    }
    <section id="technical-skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="text-2xl font-semibold">
        Technical skills
      </h2>
      <TechnicalSkills />
    </section>
    <section id="certifications" aria-labelledby="certifications-heading">
      <h2 id="certifications-heading" class="text-2xl font-semibold">
        Certifications
      </h2>
      <Certifications />
    </section>
    <section>
      <h2 class="text-xl font-semibold">Explore the work</h2>
      <p class="mt-3 leading-relaxed">
        My projects document the methods, experiments, and results in more
        detail. Competition entries are included there alongside the broader
        research portfolio.
      </p>
      <div class="mt-4 flex flex-wrap gap-5 text-sm font-semibold text-primary">
        <a href="/projects" class="underline underline-offset-4">Projects</a>
        <a href="/about" class="underline underline-offset-4"
          >The motivation behind my work</a
        >
        <a href={PROFILE.links.email} class="underline underline-offset-4"
          >Get in touch</a
        >
      </div>
    </section>
  </div>
</IndexPageLayout>
