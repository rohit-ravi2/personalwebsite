---
import BaseLayout from "../layouts/BaseLayout.astro";
import IntroCard from "../components/sections/IntroCard.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import Card from "../components/Card.astro";
import ExperienceCard from "../components/sections/ExperienceCard.astro";
import Projects from "../components/sections/Projects.astro";
import StudyCard from "../components/sections/StudyCard.astro";
import { PROFILE } from "../content/profileData";
import BlogCard from "../components/sections/BlogCard.astro";

const SITE = PROFILE.site;
---

<BaseLayout title={SITE.SEO.title} description={SITE.SEO.description}>
  <!-- Main Content Grid -->
  <main
    transition:animate="fade"
    class="relative m-auto grid w-full max-w-6xl gap-2 overflow-hidden p-2 sm:gap-2 sm:p-4 md:grid-cols-2 md:gap-3 md:p-6 lg:grid-cols-12 lg:gap-4"
  >
    <!-- Intro -->
    <Card colSpan="lg:col-span-8 md:col-span-2">
      <IntroCard />
    </Card>

    <!-- About Me -->
    <Card
      colSpan="lg:col-span-4 md:col-span-1"
      title="Why this work matters to me"
    >
      <AboutMe />
    </Card>

    <!-- Projects -->
    <Card colSpan="lg:col-span-8 md:col-span-1" title="Selected work">
      <Projects />
    </Card>

    <!-- Quote -->
    <Card colSpan="lg:col-span-4 md:col-span-1">
      <div class="flex h-full flex-col justify-center">
        <blockquote
          class="italic text-center md:text-left md:border-l-2 md:pl-6"
        >
          “{PROFILE.words[0]}”
        </blockquote>
      </div>
    </Card>

    <!-- Education -->
    <Card
      colSpan="md:col-span-1 lg:col-span-6"
      title="Education & certificates"
    >
      <StudyCard />
    </Card>

    <!-- Experiences -->
    <Card colSpan="md:col-span-1 lg:col-span-6" title="Research experience">
      <ExperienceCard />
    </Card>

    <!-- Blog -->
    <Card
      colSpan="md:col-span-1 lg:col-span-6"
      rowSpan="md:row-span-1 lg:row-span-1"
      title="Recent writing"
    >
      <BlogCard />
    </Card>

    <!-- Contact -->
    <Card
      colSpan="md:col-span-1 lg:col-span-6"
      rowSpan="md:row-span-2 lg:row-span-1"
      title="Contact"
    >
      <div class="flex h-full w-full items-center justify-center">
        <form
          action="mailto:rohit.ravi2@gmail.com"
          method="POST"
          enctype="text/plain"
          class="flex w-full max-w-md flex-col gap-3 text-sm"
        >
          <label for="name" class="text-left font-medium">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="rounded-md border border-gray-300 p-2 text-black"
          />

          <label for="email" class="text-left font-medium">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="rounded-md border border-gray-300 p-2 text-black"
          />

          <label for="message" class="text-left font-medium">Message</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="rounded-md border border-gray-300 p-2 text-black"></textarea>

          <button
            type="submit"
            class="mt-2 rounded-md bg-emerald-700 px-4 py-2 font-semibold text-white hover:bg-emerald-800"
          >
            Send Message
          </button>
          <p class="text-xs leading-relaxed text-muted-foreground">
            Opens your email app. You can also write directly to
            <a href="mailto:rohit.ravi2@gmail.com" class="underline"
              >rohit.ravi2@gmail.com</a
            >.
          </p>
        </form>
      </div>
    </Card>
    <div class="col-span-full flex justify-end px-2 pt-2">
      <a
        href="/editor"
        class="rounded p-2 text-xs text-muted-foreground opacity-30 transition hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
        aria-label="Owner sign-in">Owner</a
      >
    </div>
  </main>
</BaseLayout>
